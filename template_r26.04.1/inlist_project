! Planet/companion engulfment, MESA r26.04.1.
! Ported 2026-09-25 from oconnor23/inlist_project (MESA r22.05.1, O'Connor et al. 2023 setup).
! See PORTING_NOTES.md for every change made in the port.

&star_job
  ! see star/defaults/star_job.defaults

    load_saved_model = .true.
    load_model_filename = 'starting_models/1M4R.mod' ! agb200 rgb10 1M80R 1M4R ...

    set_initial_age = .true.
    initial_age = 0
    set_initial_model_number = .true.
    initial_model_number = 0

    history_columns_file = 'history_columns.list'
    profile_columns_file = 'profile_columns.list'

  ! hydrodynamics: velocity variables on
    change_v_flag = .true.
    change_initial_v_flag = .false.
    new_v_flag = .true.

    pgstar_flag = .false. ! .true. for on-screen plots (inlist_pgstar)

/ ! end of star_job namelist


&eos
  ! see eos/defaults/eos.defaults

/ ! end of eos namelist


&kap
  ! see kap/defaults/kap.defaults
  ! As in r22.05.1: a09 for the main tables; CO and lowT tables left at their defaults
  ! (unchanged between r22.05.1 and r26.04.1).
    kap_file_prefix = 'a09'
    kap_CO_prefix = 'gs98_co'
    kap_lowT_prefix = 'lowT_fa05_gs98'
    use_Type2_opacities = .true.
    Zbase = 0.0142

/ ! end of kap namelist


&controls
  ! see star/defaults/controls.defaults

  ! convection: explicit, since the r26 default is 'TDC'
    MLT_option = 'Cox'

    use_other_energy = .true.

  ! energy conservation (MESA V, Sec. 3)
    use_gold_tolerances = .true.
    energy_eqn_option = 'dedt'

  ! r22.05.1 defaults that changed in r26.04.1; pinned here so the port reproduces r22.
  ! Revisit once the port is validated (PORTING_NOTES.md).
    use_gold2_tolerances = .true.         ! r26 default .false.
    use_time_centered_eps_grav = .false.  ! r26 default .true.

    super_eddington_scaling_factor = 1
    super_eddington_wind_Ledd_factor = 1
    surf_avg_tau = 100
    trace_super_eddington_wind_boost = .true.

    profile_header_include_sys_details = .false.

  ! Engulfment parameters (src/run_star_extras.f90 header lists all controls)
    x_ctrl(1) = 0.001    ! companion mass (Msun); 0.001 Msun ~ M_J
    x_ctrl(2) = 0.1      ! companion radius (Rsun); 0.1 Rsun ~ R_J
    x_ctrl(3) = -10      ! stop the orbit at a < this (Rsun); <= 0 to disable
    x_ctrl(4) = 0.005    ! grazing: max |da| per step / kernel half-width
    x_ctrl(5) = 0.5      ! engulfed: max |da| per step / kernel half-width
    x_ctrl(6) = 4.3      ! initial separation (Rsun)
    x_ctrl(7) = 1d-4     ! max |da|/a per step from tides
    x_ctrl(8) = 1d-10    ! tidal sigma (Hansen 2010 units); <= 0: no tides
    x_ctrl(9) = 1.0      ! alpha in R_2 + alpha*H_P (kernel 2)
    x_ctrl(10) = -1      ! C_d: > 0 constant; <= 0 Mach-dependent (O'Connor+23 Eq. 8)
    x_ctrl(11) = -1      ! C_g: > 0 constant; <= 0 Ostriker, ln Lambda = ln(H_P/R_inf), regular at Mach 1
    x_ctrl(12) = 10      ! after disruption, relax for this many KH times, then stop
    x_ctrl(13) = 10      ! minimum orbit sub-steps per MESA step
    x_ctrl(14) = 0       ! mesh refinement around the companion (~cells per kernel half-width); 0 = off
    x_integer_ctrl(1) = 1  ! drag law: 0 draft (C=1, pi max(R_2,R_acc)^2), 1 max(hydro,grav), 2 sum
    x_integer_ctrl(2) = 1  ! kernel: 1 |r-a|<R_inf, 2 |r-a|<R_2+alpha H_P, 3 |r-a|<H_P/2, 4 Gaussian(R_inf)
    x_integer_ctrl(3) = 10 ! terminal output every N models
    x_integer_ctrl(4) = 1  ! outflow: 0 none, 1 A (energy-limited prescription), 2 B (hydro, remove unbound gas)
    x_ctrl(15) = 1.0       ! f_w, efficiency of option A -- PROVISIONAL until calibrated against option B
    x_ctrl(16) = 1.0       ! beta = v_inf / v_esc,surf of the option-A outflow
    x_logical_ctrl(1) = .false. ! tides also when a < R_*
    x_logical_ctrl(2) = .true.  ! deposit tidal heat in the outer convective envelope

    use_other_mesh_functions = .true.  ! refinement active only if x_ctrl(14) > 0
    use_other_adjust_mdot = .true.     ! engulfment outflow (x_integer_ctrl(4))

  ! output
    photo_interval = 50
    profile_interval = 2
    history_interval = 1
    max_num_profile_models = 10000
    photo_digits = 5

  ! timesteps and solver
    min_timestep_limit = 1d-12
    varcontrol_target = 1d-3

  ! mesh
    mesh_delta_coeff = 0.8

/ ! end of controls namelist
